{
    "application": {
        "name": "USRP Wideband Signal Detection",
        "authors": [
            {
                "name": "Sage Trudeau",
                "affiliation": "UT Austin"
            }
        ],
        "language": "C++",
        "version": "1.0.0",
        "changelog": {
            "0.1.0": "Initial C++ application scaffold with spectrogram + DINOv3 signal detector flow",
            "0.2.0": "Added selectable coherent-power detector scaffolding alongside the existing DINOv3 path",
            "1.0.0": "Release: coherent-power + zero-shot DINOv3 + fine-tuned DINOv3 (M5-S) detectors, signal snipper + SigMF sink, live dashboard, offline dataset preprocessing, DGX Spark (aarch64) support"
        },
        "holoscan_sdk": {
            "minimum_required_version": "3.5.0",
            "tested_versions": [
                "3.5.0",
                "3.6.0",
                "3.7.0",
                "3.8.0",
                "3.9.0"
            ]
        },
        "platforms": [
            "x86_64",
            "aarch64"
        ],
        "tags": [
            "USRP",
            "SDR",
            "DINOv3",
            "Coherent Power",
            "Signal Detection",
            "Argus"
        ],
        "ranking": 4,
        "dependencies": {
            "operators": [
                "fft",
                "spectrogram",
                "cuda_dino_detector",
                "coherent_power_signal_detector",
                "finetuned_dino_detector"
            ],
            "libraries": [
                {
                    "name": "MatX",
                    "version": "0.9.2",
                    "url": "https://github.com/NVIDIA/MatX.git"
                }
            ]
        },
        "run": {
            "command": "<holohub_app_bin>/usrp_wideband_signal_detection config_coherent_power_perf_dynamic_single_channel.yaml",
            "workdir": "holohub_bin"
        }
    }
}
